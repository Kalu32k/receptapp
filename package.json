{
  "name": "receptapp",
  "version": "1.0.0",
  "description": "En mobilapp för att lagra och dela recept",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watch --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.2",
    "expo": "^50.0.0",
    "expo-font": "~11.10.3",
    "expo-splash-screen": "~0.26.4",
    "expo-sqlite": "~13.2.1",
    "react": "18.2.0",
    "react-hook-form": "^7.48.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.27.0",
    "react-native-uuid": "^2.0.1",
    "react-native-vector-icons": "^10.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "~18.2.45",
    "@types/react-native": "^0.72.8",
    "jest": "^29.7.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "private": true,
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo|@expo|@unimodules|react-native-uuid|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-vector-icons|@react-navigation)/)"
    ],
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.ts",
      "^react-native-uuid$": "<rootDir>/__mocks__/react-native-uuid.ts"
    }
  }
}
